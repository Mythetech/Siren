@implements IDisposable
@using Mythetech.Framework.Components.AppContextDrawer
@using Mythetech.Framework.Infrastructure.Plugins
@using Mythetech.Framework.Infrastructure.Plugins.Components
@using Siren.Components.Settings
@using Siren.Components.History
@using Siren.Components.Collections
@using Siren.Components.Variables
@using Siren.Components.SessionStats
@using Siren.Components.MockServer
@using MouseEvent = MudBlazor.MouseEvent

<AppContextDrawer IsOpen="@AppState.SideBarOpen" IsOpenChanged="@HandleDrawerOpenChanged" @bind-ActivePanelId="@_activePanelId"
                  ShowPluginPanels="false" CloseIcon="@SirenIcons.Close"
                  ContentClass="" ContentSpacing="0" HeaderClass="pa-2 mb-2" HeaderSpacing="3"
                  FullWidthItems="true" ItemColor="Color.Inherit" TooltipColor="Color.Default">
    <IconBarHeader>
        <SirenIconButton Class="m-1 p-1" Icon="app-icon" OnClick="@OpenAboutSiren" />
    </IconBarHeader>

    <PanelNavContent>
        <ContextPanelItem Id="@SirenPanels.History" Title="History" Icon="@SirenIcons.History">
            <PanelContent>
                <HistoryPanel IsDarkMode="@IsDarkMode" />
            </PanelContent>
        </ContextPanelItem>
        <ContextPanelItem Id="@SirenPanels.Collections" Title="Collections" Icon="@SirenIcons.Collections">
            <PanelContent>
                <CollectionsPanel />
            </PanelContent>
        </ContextPanelItem>
        <ContextPanelItem Id="@SirenPanels.Variables" Title="Variables" Icon="@SirenIcons.Variables">
            <PanelContent>
                <VariablesPanel />
            </PanelContent>
        </ContextPanelItem>
        <ContextPanelItem Id="@SirenPanels.MockServer" Title="Mock Server" Icon="@SirenIcons.MockServer">
            <PanelContent>
                <MockServerPanel />
            </PanelContent>
        </ContextPanelItem>
        @if (SessionStatsSettings.ShowSessionStats)
        {
            <ContextPanelItem Id="@SirenPanels.SessionStats" Title="Session Stats" Icon="@SirenIcons.Stats">
                <PanelContent>
                    <SessionStatsPanel />
                </PanelContent>
            </ContextPanelItem>
        }
        @if (Plugins.PluginsActive && Plugins.EnabledPlugins.Any(x => x.ContextPanelComponents.Count > 0))
        {
            <MudDivider Class="my-1" Style="max-height: 2px;" />
            @foreach (var plugin in Plugins.EnabledPlugins.Where(x => x.ContextPanelComponents.Count > 0))
            {
                @foreach (var component in plugin.ContextPanelComponentsMetadata)
                {
                    <ContextPanelItem @key="component.ComponentType" Id="@($"plugin-{component.ComponentType.FullName}")"
                                      Title="@component.Title" Icon="@component.Icon">
                        <PanelContent>
                            <PluginGuard Metadata="component" PluginInfo="plugin">
                                <DynamicComponent Type="component.ComponentType" />
                            </PluginGuard>
                        </PanelContent>
                    </ContextPanelItem>
                }
            }
        }
    </PanelNavContent>

    <PanelFooterContent>
        <MudMenu ActivationEvent="MouseEvent.MouseOver" AnchorOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudIconButton Icon="@(AppState.IsDarkMode? SirenIcons.DarkMode: SirenIcons.LightMode)"
                               Color="Color.Primary" Variant="Variant.Text" OnClick="@DarkModeToggled" />
            </ActivatorContent>
            <ChildContent>
                <MudToggleGroup T="string" Size="Size.Small" Value="@SelectedColorMode"
                                ValueChanged="HandleColorModeChanged" Style="align-items: center">
                    <ToggleIcon Value="light" Icon="@SirenIcons.LightMode" Text="Light Mode" />
                    <ToggleIcon Value="dark" Icon="@SirenIcons.DarkMode" Text="Dark Mode" />
                    <ToggleIcon Value="system" Icon="@SirenIcons.Round("laptop")" Text="System Default" />
                </MudToggleGroup>
            </ChildContent>
        </MudMenu>
        <MudTooltip Text="Settings" Placement="Placement.Right">
            <MudIconButton Color="Color.Primary" Icon="@SirenIcons.Settings" OnClick="OpenSettingsDialog" />
        </MudTooltip>

        <MudIconButton Icon="@(AppState.SideBarOpen? SirenIcons.CollapseLeft: SirenIcons.ExpandRight)" Color="Color.Inherit"
                       OnClick="@DrawerToggled" />
    </PanelFooterContent>

    <EmptyContent>
        <SirenStack Row="true" Class="w-100 pa-4">
            <SirenText Typo="Typo.subtitle1">No Item Selected</SirenText>
            <SirenSpacer />
            <MudIconButton Icon="@SirenIcons.Close" Variant="Variant.Text" OnClick="@DrawerToggled" />
        </SirenStack>
        <SirenText Typo="Typo.subtitle2" Class="mud-text-secondary">Select an item from the side menu</SirenText>
    </EmptyContent>
</AppContextDrawer>

@code {
    [Inject]
    protected SirenAppState AppState { get; set; } = default!;

    [Inject] protected PluginState Plugins { get; set; } = default!;

    [Inject] protected SettingsState Settings { get; set; } = default!;

    [Inject] protected SessionStatsSettings SessionStatsSettings { get; set; } = default!;

    [Inject]
    protected IDialogService DialogService { get; set; } = default!;

    [Parameter]
    public bool IsDarkMode { get; set; } = false;

    [Parameter]
    public EventCallback DarkModeToggled { get; set; }

    [Parameter]
    public EventCallback DrawerToggled { get; set; }

    private string SelectedColorMode => AppState.IsDarkMode ? "dark" : "light";

    private string? _activePanelId;

    protected async Task HandleColorModeChanged(string s)
    {
        if (!AppState.IsDarkMode && s.Equals("light", StringComparison.OrdinalIgnoreCase))
            return;

        if (s.Equals("light", StringComparison.OrdinalIgnoreCase))
        {
            AppState.IsDarkMode = false;
        }
        else
        {
            AppState.IsDarkMode = true;
        }

        StateHasChanged();
    }

    private void PluginStateChanged(object? sender, EventArgs args) => StateHasChanged();

    private void SettingsStateChanged(SettingsState s) => StateHasChanged();

    protected override void OnInitialized()
    {
        AppState.OnChange += SideBarChanged;
        Plugins.StateChanged += PluginStateChanged;
        Settings.SettingsChanged += SettingsStateChanged;
    }
    protected void SideBarChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    // The layout owns the MudDrawer this rail sits in, so it is the layout that has to open or close it
    private async Task HandleDrawerOpenChanged(bool isOpen)
    {
        if (AppState.SideBarOpen != isOpen)
        {
            await DrawerToggled.InvokeAsync();
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= SideBarChanged;
        Plugins.StateChanged -= PluginStateChanged;
        Settings.SettingsChanged -= SettingsStateChanged;
    }

    protected async Task OpenSettingsDialog()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackgroundClass = "siren-dialog",
            MaxWidth = MaxWidth.Large
        };

        var dialog = await DialogService.ShowAsync<SettingsDialog>("Settings", options);
        var result = await dialog.Result;
    }

    protected async Task OpenAboutSiren()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackgroundClass = "siren-dialog",
            MaxWidth = MaxWidth.Small
        };

        var dialog = await DialogService.ShowAsync<AboutSiren>("About", options);
        var result = await dialog.Result;
    }
}