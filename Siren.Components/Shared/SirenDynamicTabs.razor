@inherits SirenBaseComponent
@using Siren.Components.Http
@using Siren.Components.Http.Models
@using MouseEvent = MudBlazor.MouseEvent
@typeparam T

<SirenDynamicTabBar @ref="@DynamicTabs"
                AddTab="@HandleAddTab"
                CloseTab="@HandleCloseTab"
                ActivePanelIndexChanged="@HandleActivePanelIndexChanged"
                AddIconToolTip="New Request"
                AddIconClass="icon-btn-sm"
                CloseIconToolTip="Close"
                Color="@Color"
                MinimumTabWidth="60"
                MaxHeight="38"
                Class="@($"{Class}")"
                Style="@Style"
                PanelClass="px-1"
                Elevation="@Elevation"
                Rounded="@Rounded"
                ScrollIconColor="MudBlazor.Color.Primary"
                HeaderContent="@HeaderContent"
                ApplyEffectsToContainer>
    @foreach (var item in Items)
    {
        var request = item as SirenNetworkRequest;
        <MudTabPanel @key="request!.Id" ID="@(request.Id)" ShowCloseIcon="true" Icon="@SirenIcons.Close">
            <TabContent>
                <MudMenu ActivationEvent="MudBlazor.MouseEvent.RightClick" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true" ListClass="pa-1">
                    <ActivatorContent>
                        <div @oncontextmenu="@context.ToggleAsync" @oncontextmenu:preventDefault="true" style="display: contents;">
                            <NetworkRequestTab Request="@request" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem class="rounded-lg" OnClick="@(() => HandleDuplicate(item))">Duplicate</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </TabContent>
        </MudTabPanel>
    }
</SirenDynamicTabBar>

@code {
    [Parameter]
    public MudBlazor.Color Color { get; set; } = MudBlazor.Color.Primary;

    [Parameter]
    public int Elevation { get; set; } = 4;

    [Parameter]
    public IReadOnlyList<T> Items { get; set; } = [];

    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Parameter]
    public EventCallback<T> ItemClosed { get; set; }

    [Parameter]
    public EventCallback ItemAdded { get; set; }

    [Parameter]
    public EventCallback<T> TabChanged { get; set; }

    [Parameter]
    public EventCallback<T> TabDuplicated { get; set; }

    [Parameter]
    public bool Rounded { get; set; } = false;

    public MudDynamicTabs DynamicTabs = default!;

    /// <summary>
    /// The id of the panel the strip shows as active, or null while it shows none.
    /// </summary>
    public Guid? ActivePanelId => DynamicTabs?.ActivePanel?.ID as Guid?;

    /// <summary>
    /// Makes the panel with the given id the active one. Returns false when the strip has no such panel yet.
    /// </summary>
    public async Task<bool> ActivateAsync(Guid id)
    {
        var panel = DynamicTabs?.Panels.FirstOrDefault(p => Equals(p.ID, id));
        if (panel == null)
            return false;

        await DynamicTabs!.ActivatePanelAsync(panel);
        return true;
    }

    private Task HandleAddTab() => ItemAdded.InvokeAsync();

    private Task HandleCloseTab(MudTabPanel panel)
    {
        var item = Items.FirstOrDefault(x => Equals((x as SirenNetworkRequest)?.Id, panel.ID));
        return item is null ? Task.CompletedTask : ItemClosed.InvokeAsync(item);
    }

    private Task HandleActivePanelIndexChanged(int index)
    {
        // The strip reports -1 while it has no panel, and can report an index from before a close
        if (index < 0 || index >= Items.Count)
            return Task.CompletedTask;

        return TabChanged.InvokeAsync(Items[index]);
    }

    private Task HandleDuplicate(T item) => TabDuplicated.InvokeAsync(item);
}
