@using Siren.Components.Http.Models
@implements IDisposable

<SirenDynamicTabs T="SirenNetworkRequest"
                  @ref="_tabs"
                  Elevation="0"
                  Color="Color.Primary"
                  Items="@Tabs.Tabs"
                  Class="@($"w-100 {(AppState.SideBarOpen ? "siren-app-short-tabs" : "siren-app-tabs")}")"
                  Style="height:38px"
                  ItemAdded="HandleTabAdded"
                  ItemClosed="HandleTabClosed"
                  TabChanged="HandleTabSelected"
                  TabDuplicated="HandleTabDuplicated"
                  HeaderContent="@HeaderContent" />

@code {
    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Inject]
    protected SirenAppState AppState { get; set; } = default!;

    [Inject]
    protected RequestTabsState Tabs { get; set; } = default!;

    private SirenDynamicTabs<SirenNetworkRequest> _tabs = default!;

    protected override void OnInitialized()
    {
        Tabs.TabsChanged += HandleTabsChanged;
        Tabs.ActiveTabChanged += HandleTabChanged;
        Tabs.RequestChanged += HandleTabChanged;
        AppState.OnAppStateChanged += HandleAppStateChanged;
    }

    public void Dispose()
    {
        Tabs.TabsChanged -= HandleTabsChanged;
        Tabs.ActiveTabChanged -= HandleTabChanged;
        Tabs.RequestChanged -= HandleTabChanged;
        AppState.OnAppStateChanged -= HandleAppStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The strip keeps its own active panel, so it is told whenever the state's active tab is not the
        // one it shows. It can only be told after a render, once the panel for a new tab exists.
        var activeId = Tabs.Active.Id;
        if (_tabs.ActivePanelId != activeId)
            await _tabs.ActivateAsync(activeId);
    }

    private void HandleTabsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleTabChanged(SirenNetworkRequest tab)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleAppStateChanged(SirenAppState state)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleTabAdded() => Tabs.OpenNew();

    private void HandleTabClosed(SirenNetworkRequest tab) => Tabs.Close(tab.Id);

    private void HandleTabSelected(SirenNetworkRequest tab) => Tabs.Activate(tab.Id);

    private void HandleTabDuplicated(SirenNetworkRequest tab) => Tabs.Duplicate(tab.Id);
}
