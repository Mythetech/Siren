@page "/"
@page "/index"
@implements IAsyncDisposable
@using Siren.Components.Theme
@using Siren.Components.Shared
@using Siren.Components.Shared.Notifications
@using Siren.Components.Http
@using Siren.Components.Http.Models
@using Siren.Components.Services
@using Siren.Components.RequestContextPanel
@using Siren.Components.Infrastructure.Keyboard
@using System.Text.Json
@using System.Text.Encodings
@using Microsoft.JSInterop
@using MudBlazor
@using System.Net.Sockets
@using System.Reflection
@using System.Runtime.InteropServices
@using Mythetech.Framework.Desktop.Updates
@using Mythetech.Framework.Infrastructure.Plugins
@using Mythetech.Framework.Infrastructure.Smoke
@using Siren.Components.Settings
@using Siren.Components.SessionStats

<MudStack Row="true" Class="w-100 h-100 ml-1" Spacing="0">
    <MudSplitPanel @ref="_outerSplitter" PanelGap="2" Transparent="true" MinPanelSize="50"
                   Class="@($"h-100{(sidePanelClosed ? " divider-locked" : "")}")" Style="@($"width: {GetSplitterWidth()}")">
        <FirstPanel>
            <MudSplitPanel Horizontal="true" PanelGap="2" Transparent="true" MinPanelSize="150" Class="w-100 h-100">
                <FirstPanel>
                    <MudPaper Height="100%" Elevation="0" Width="100%">
                        <RequestPanel @ref="_requestPanel" SendClicked="HandleSendClicked" />
                    </MudPaper>
                </FirstPanel>
                <SecondPanel>
                    <MudPaper Height="100%" Elevation="0" Width="100%">
                        <ResponsePanel />
                    </MudPaper>
                </SecondPanel>
            </MudSplitPanel>
        </FirstPanel>
        <SecondPanel>
            @if (!sidePanelClosed)
            {
                <MudPaper Height="100%" Width="100%">
                    <RequestContextPanel @ref="_requestContextPanel" IsOpen="true"
                                         PanelClosed="@(() => ToggleSidePanel())" />
                </MudPaper>
            }
            else
            {
                <MudStack Spacing="3" AlignItems="AlignItems.Center" Class="h-100 pt-3"
                          Style="border-left: solid 1px var(--mud-palette-primary); min-width: 48px">
                    <SirenIconButton Tooltip="Authorization" Icon="@SirenIcons.Auth"
                                     OnClick="@(() => ToggleSidePanel("Auth"))" />
                    <SirenIconButton Tooltip="Headers" Icon="@SirenIcons.Headers"
                                     OnClick="@(() => ToggleSidePanel("Headers"))" />
                    <SirenIconButton Tooltip="Cookies" Icon="@SirenIcons.Cookies"
                                     OnClick="@(() => ToggleSidePanel("Cookies"))" />
                </MudStack>
            }
        </SecondPanel>
    </MudSplitPanel>
    <SirenKeyCodeProvider OnRunRequest="HandleSendClicked" OnNewTab="HandleNewTab" OnFocusUri="HandleFocusUri"
                          OnFocusMethod="HandleFocusMethod" />
</MudStack>

@code {
    [Inject]
    protected SirenAppState AppState { get; set; } = default!;

    [Inject]
    protected RequestTabsState Tabs { get; set; } = default!;

    [Inject]
    protected IRequestSender Sender { get; set; } = default!;

    [Inject] protected IJSRuntime JS { get; set; } = default!;

    [Inject] protected PluginState PluginState { get; set; } = default!;
    [Inject] protected PluginLoader PluginLoader { get; set; } = default!;

    [Inject] protected IUpdateService UpdateService { get; set; } = default!;

    [Inject] protected ISmokeTestContext SmokeTest { get; set; } = default!;

    private IJSObjectReference? _module;

    private MudSplitPanel _outerSplitter = default!;

    private RequestPanel _requestPanel = default!;

    private RequestContextPanel.RequestContextPanel _requestContextPanel = default!;

    private bool sidePanelClosed = true;

    private bool _disposed;

    private string GetSplitterWidth()
    {
        var drawerWidth = AppState.SideBarOpen
            ? "var(--mud-drawer-width-left)"
            : "var(--mud-drawer-width-mini-left)";

        return $"calc(100% - {drawerWidth})";
    }

    private async Task<int> GetOuterSplitterWidthAsync()
    {
        return await JS.InvokeAsync<int>("eval",
            "document.querySelector('.mud-split-panel:not(.horizontal)')?.getBoundingClientRect().width ?? 800");
    }

    protected async Task ToggleSidePanel(string selectedTab = "")
    {
        sidePanelClosed = !sidePanelClosed;
        StateHasChanged();
        await Task.Yield();

        if (!sidePanelClosed)
        {
            var containerWidth = await GetOuterSplitterWidthAsync();
            await _outerSplitter.SetDividerPositionAsync((int)(containerWidth * 0.7));

            if (!string.IsNullOrWhiteSpace(selectedTab))
            {
                StateHasChanged();
                await Task.Yield();
                _requestContextPanel?.Open(selectedTab);
            }
        }

        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        AppState.OnAppStateChanged += HandleAppStateChanged;
        AppState.OnFormatRequest += HandleFormatRequest;
        AppState.OnOpenRequestContextPanel += HandleOpenRequestContextPanel;
    }

    private void HandleAppStateChanged(SirenAppState state)
    {
        InvokeAsync(StateHasChanged);
    }

    private Task HandleFormatRequest()
        => _requestPanel == null ? Task.CompletedTask : InvokeAsync(() => _requestPanel.FormatDocumentAsync());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./app.js");

            // The packaged builds CI smoke tests count as installed, so without this a smoke run would query the
            // release feed and could offer an update.
            if (!SmokeTest.IsEnabled)
                await UpdateService.CheckForUpdatesOnStartupAsync();
        }
    }

    protected void HandleNewTab() => Tabs.OpenNew();

    private async Task HandleOpenRequestContextPanel(string tab)
    {
        await InvokeAsync(async () => await ToggleSidePanel(tab));
    }

    protected async Task HandleFocusUri()
    {
        if (_requestPanel != null)
        {
            await _requestPanel.FocusUriInputAsync();
        }
    }

    protected async Task HandleFocusMethod()
    {
        if (_requestPanel != null)
        {
            await _requestPanel.FocusHttpMethodDropdownAsync();
        }
    }

    protected async Task HandleSendClicked()
    {
        var tab = Tabs.Active;

        if (tab.IsSending)
        {
            Sender.Cancel(tab.Id);
            return;
        }

        var outcome = await Sender.SendAsync(tab.Id);

        // The page may have been left while the request ran, and its fields are gone with it
        if (_disposed)
            return;

        if (outcome == SendOutcome.MissingMethod)
            await _requestPanel.FocusHttpMethodDropdownAsync();
        else if (outcome is SendOutcome.MissingUrl or SendOutcome.Failed or SendOutcome.TimedOut)
            await _requestPanel.FocusUriInputAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        AppState.OnAppStateChanged -= HandleAppStateChanged;
        AppState.OnFormatRequest -= HandleFormatRequest;
        AppState.OnOpenRequestContextPanel -= HandleOpenRequestContextPanel;

        if (_module == null)
            return;

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The WebView has already gone, and the module went with it
        }
    }

}
