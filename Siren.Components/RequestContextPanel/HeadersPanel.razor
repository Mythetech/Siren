@using Siren.Components.Http
@using Siren.Components.Http.Models
@implements IDisposable
@{ RefreshRows(); }

<SirenStack Class="w-100 h-100 d-flex">
    <SirenSplitter Horizontal="true" Class="w-100">
        <Panel1>
            <SirenStack Spacing="3" Class="p-1 overflow-auto d-flex h-100 w-100">
                <SirenStack Row="true" Spacing="3" Class="w-100" AlignItems="AlignItems.Center">
                    <SirenText Typo="Typo.body1">Request Headers</SirenText>
                    <SirenSpacer/>
                    <SirenIconButton OnClick="@(() => AddRequestHeader("Key", "Value"))"
                                     Icon="@SirenIcons.Add"
                                     Tooltip="@($"Add Header")"
                                     Class="scale-75"
                                     Size="Size.Medium"
                                     Variant="Variant.Text"
                                     Color="Color.Primary"/>
                </SirenStack>

                <MudDataGrid T="HeaderModel"
                             Items="@allHeaders"
                             Context="context"
                             Class="w-100"
                             Bordered="false"
                             Elevation="0"
                             RowClass="text-truncate hover-error-zone"
                             Style="overflow:hidden;"
                             EditMode="DataGridEditMode.Cell"
                             EditTrigger="DataGridEditTrigger.Manual"
                             CommittedItemChanges="UpdateHeader"
                             ReadOnly="false"
                             Dense="true"
                             Hover="true">
                    <Columns>
                        <MudBlazor.PropertyColumn Property="x => x.Key" Title="Header">
                            <EditTemplate>
                                <MudTextField Value="@context.Item.Key"
                                              ValueChanged="@((string? key) => SetKey(context.Item, key))"
                                              Disabled="@context.Item.IsSystemHeader"
                                              Class="w-100"/>
                            </EditTemplate>
                            <CellTemplate>
                                <MudTextField Value="@context.Item.Key" 
                                              ReadOnly="@context.Item.IsSystemHeader"
                                              Disabled="@context.Item.IsSystemHeader"
                                              Class="w-100"/>
                            </CellTemplate>
                        </MudBlazor.PropertyColumn>

                        <MudBlazor.PropertyColumn Property="x => x.Value" Title="Value">
                            <EditTemplate>
                                <MudTextField Value="@context.Item.Value"
                                              ValueChanged="@((string? value) => SetValue(context.Item, value))"
                                              Disabled="@context.Item.IsSystemHeader"
                                              Class="w-100"/>
                            </EditTemplate>
                            <CellTemplate>
                                <MudTextField Value="@context.Item.Value" 
                                              ReadOnly="@context.Item.IsSystemHeader"
                                              Disabled="@context.Item.IsSystemHeader"
                                              Class="w-100"/>
                            </CellTemplate>
                        </MudBlazor.PropertyColumn>
                        <MudBlazor.TemplateColumn Title="Enabled">
                            <CellTemplate>
                                <SirenSwitch Value="@context.Item.Enabled" 
                                             ValueChanged="@((bool value) => ToggleHeaderEnabled(context.Item, value))"
                                             Disabled="@context.Item.IsSystemHeader"
                                             Size="Size.Small"
                                             Color="Color.Primary"/>
                            </CellTemplate>
                            <EditTemplate>
                                <SirenSwitch Value="@context.Item.Enabled" 
                                             ValueChanged="@((bool value) => ToggleHeaderEnabled(context.Item, value))"
                                             Disabled="@context.Item.IsSystemHeader"
                                             Size="Size.Small"
                                             Color="Color.Primary"/>
                            </EditTemplate>
                        </MudBlazor.TemplateColumn>
                        <MudBlazor.TemplateColumn Title="">
                            <CellTemplate>
                                <MudMenu ListClass="pa-1" Dense="true"
                                         AnchorOrigin="Origin.BottomLeft"
                                         TransformOrigin="Origin.TopRight">
                                    <ActivatorContent Context="menuContext">
                                        <SirenIconButton Icon="@SirenIcons.MoreVert"
                                                         Variant="Variant.Text"
                                                         Color="Color.Inherit"
                                                         OnClick="@(() => menuContext.ToggleAsync())" />
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem class="rounded-lg" Icon="@SirenIcons.Copy"
                                                     OnClick="@(async () =>
                                                     {
                                                         await JsApiService.CopyToClipboardAsync(context.Item.Key);
                                                         NotifyCopied(context.Item.Key);
                                                     })">
                                            Copy Key
                                        </MudMenuItem>
                                        <MudMenuItem class="rounded-lg" Icon="@SirenIcons.Copy"
                                                     OnClick="@(async () =>
                                                     {
                                                         await JsApiService.CopyToClipboardAsync(context.Item.Value);
                                                         NotifyCopied(context.Item.Value);
                                                     })">
                                            Copy Value
                                        </MudMenuItem>
                                        @if (!context.Item.IsSystemHeader)
                                        {
                                            <MudDivider />
                                            <MudMenuItem class="rounded-lg" Icon="@SirenIcons.Delete"
                                                         OnClick="@(() => DeleteHeader(context.Item))">
                                                Delete Header
                                            </MudMenuItem>
                                        }
                                    </ChildContent>
                                </MudMenu>
                            </CellTemplate>
                            <EditTemplate>
                                <MudMenu ListClass="pa-1" Dense="true"
                                         AnchorOrigin="Origin.BottomLeft"
                                         TransformOrigin="Origin.TopRight">
                                    <ActivatorContent Context="menuContext">
                                        <SirenIconButton Icon="@SirenIcons.MoreVert"
                                                         Variant="Variant.Text"
                                                         Color="Color.Inherit"
                                                         OnClick="@(() => menuContext.ToggleAsync())" />
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem class="rounded-lg" Icon="@SirenIcons.Copy"
                                                     OnClick="@(async () =>
                                                     {
                                                         await JsApiService.CopyToClipboardAsync(context.Item.Key);
                                                         NotifyCopied(context.Item.Key);
                                                     })">
                                            Copy Key
                                        </MudMenuItem>
                                        <MudMenuItem class="rounded-lg" Icon="@SirenIcons.Copy"
                                                     OnClick="@(async () =>
                                                     {
                                                         await JsApiService.CopyToClipboardAsync(context.Item.Value);
                                                         NotifyCopied(context.Item.Value);
                                                     })">
                                            Copy Value
                                        </MudMenuItem>
                                        @if (!context.Item.IsSystemHeader)
                                        {
                                            <MudDivider />
                                            <MudMenuItem class="rounded-lg" Icon="@SirenIcons.Delete"
                                                         OnClick="@(() => DeleteHeader(context.Item))">
                                                Delete Header
                                            </MudMenuItem>
                                        }
                                    </ChildContent>
                                </MudMenu>
                            </EditTemplate>
                        </MudBlazor.TemplateColumn>

                    </Columns>
                </MudDataGrid>
            </SirenStack>
        </Panel1>
        <Panel2>
            <SirenStack Spacing="3" Class="p-1 overflow-auto flex-grow-1 d-flex w-100 h-100">
                <SirenText Typo="Typo.body1">Response Headers</SirenText>
                @if (responseHeaders.Count > 0)
                {
                    <MudDataGrid T="DictionaryViewModel"
                                 Items="@responseHeaders"
                                 Context="context"
                                 Class="w-100 h-100 d-flex"
                                 Bordered="false"
                                 Elevation="0"
                                 RowClass="text-truncate hover-error-zone"
                                 Style="overflow:hidden;"
                                 ReadOnly="true"
                                 Dense="true"
                                 Hover="true"
                                 RowKeySelector="x => x.Id">
                        <Columns>
                            <MudBlazor.PropertyColumn Property="x => x.Key" Title="Header">
                                <CellTemplate>
                                    <MudTextField Value="@context.Item.Key"
                                                  ReadOnly="true"
                                                  Class="w-100"/>
                                </CellTemplate>
                            </MudBlazor.PropertyColumn>

                            <MudBlazor.PropertyColumn Property="x => x.Value" Title="Value">
                                <CellTemplate>
                                    <MudTextField Value="@context.Item.Value"
                                                  ReadOnly="true"
                                                  Class="w-100"/>
                                </CellTemplate>
                            </MudBlazor.PropertyColumn>
                            <MudBlazor.TemplateColumn Title="">
                                <CellTemplate>
                                    <MudMenu ListClass="pa-1" Dense="true"
                                             AnchorOrigin="Origin.BottomLeft"
                                             TransformOrigin="Origin.TopRight">
                                        <ActivatorContent Context="menuContext">
                                            <SirenIconButton Icon="@SirenIcons.MoreVert"
                                                             Variant="Variant.Text"
                                                             Color="Color.Inherit"
                                                             OnClick="@(() => menuContext.ToggleAsync())" />
                                        </ActivatorContent>
                                        <ChildContent>
                                            <MudMenuItem class="rounded-lg" Icon="@SirenIcons.Copy"
                                                         OnClick="@(async () =>
                                                         {
                                                             await JsApiService.CopyToClipboardAsync(context.Item.Key);
                                                             NotifyCopied(context.Item.Key);
                                                         })">
                                                Copy Key
                                            </MudMenuItem>
                                            <MudMenuItem class="rounded-lg" Icon="@SirenIcons.Copy"
                                                         OnClick="@(async () =>
                                                         {
                                                             await JsApiService.CopyToClipboardAsync(context.Item.Value);
                                                             NotifyCopied(context.Item.Value);
                                                         })">
                                                Copy Value
                                            </MudMenuItem>
                                        </ChildContent>
                                    </MudMenu>
                                </CellTemplate>
                            </MudBlazor.TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                }
            </SirenStack>
        </Panel2>
    </SirenSplitter>
</SirenStack>

@code {
    [Inject]
    public RequestTabsState Tabs { get; set; } = default!;

    private SirenNetworkRequest NetworkRequest => Tabs.Active;

    private Guid _rowsTabId;

    [Inject]
    public IJsApiService JsApiService { get; set; } = default!;

    [Inject]
    public ISnackbar Snackbar { get; set; } = default!;

    private List<HeaderModel> requestHeaders = new();
    private List<HeaderModel> allHeaders = new();
    private List<DictionaryViewModel> responseHeaders = new();

    protected override void OnInitialized()
    {
        Tabs.ActiveTabChanged += HandleTabChanged;
        Tabs.RequestChanged += HandleTabChanged;
        Tabs.ResponseChanged += HandleTabChanged;
    }

    public void Dispose()
    {
        Tabs.ActiveTabChanged -= HandleTabChanged;
        Tabs.RequestChanged -= HandleTabChanged;
        Tabs.ResponseChanged -= HandleTabChanged;
    }

    private void HandleTabChanged(SirenNetworkRequest tab)
    {
        InvokeAsync(StateHasChanged);
    }

    // Runs at the start of every render, so the rows are right for the active tab before they are drawn.
    // The rows are the panel's working copy. While they say what the tab says they are left alone, so a
    // row keeps its place and a row that is blank or switched off, which the tab does not record, stays.
    private void RefreshRows()
    {
        if (_rowsTabId != NetworkRequest.Id)
        {
            // Rows that are blank or switched off belong to the tab they were typed in
            _rowsTabId = NetworkRequest.Id;
            requestHeaders = new();
        }

        var headers = NetworkRequest.Request?.Headers ?? [];
        if (!SentHeaders().SequenceEqual(headers))
            MergeHeaders(headers);

        responseHeaders = NetworkRequest.Response?.Headers?.ToViewModel() ?? new();
        UpdateAllHeaders();
    }

    // Only for headers that were changed somewhere else. The panel's own edits reach the tab in the
    // handler that makes them, so they never get here.
    private void MergeHeaders(List<KeyValuePair<string, string>> headers)
    {
        var newHeaders = headers.ToViewModel();
        var existingHeadersByKey = new Dictionary<string, HeaderModel>(StringComparer.OrdinalIgnoreCase);
        foreach (var header in requestHeaders.Where(h => !string.IsNullOrWhiteSpace(h.Key)))
        {
            // Two rows can share a name. The first keeps its row, and the merge must not throw while rendering.
            existingHeadersByKey.TryAdd(header.Key!, header);
        }

        var mergedHeaders = new List<HeaderModel>();

        foreach (var newHeader in newHeaders)
        {
            var keyLower = newHeader.Key?.ToLowerInvariant();
            if (keyLower != null && existingHeadersByKey.TryGetValue(keyLower, out var existingHeader))
            {
                existingHeader.Value = newHeader.Value;
                mergedHeaders.Add(existingHeader);
                existingHeadersByKey.Remove(keyLower);
            }
            else
            {
                mergedHeaders.Add(newHeader);
            }
        }

        foreach (var remainingHeader in existingHeadersByKey.Values)
        {
            mergedHeaders.Add(remainingHeader);
        }

        requestHeaders = mergedHeaders;
    }

    private void UpdateAllHeaders()
    {
        allHeaders.Clear();
        
        var userHeaderKeys = new HashSet<string>(
            requestHeaders.Where(h => !string.IsNullOrWhiteSpace(h.Key))
                          .Select(h => h.Key!.ToLowerInvariant()),
            StringComparer.OrdinalIgnoreCase);

        foreach (var header in requestHeaders)
        {
            allHeaders.Add(header);
        }

        if (NetworkRequest?.Response?.ActualRequestHeaders != null)
        {
            var systemHeadersDict = NetworkRequest.Response.ActualRequestHeaders
                .Where(h => !userHeaderKeys.Contains(h.Key.ToLowerInvariant()))
                .ToDictionary(h => h.Key, h => h.Value);

            foreach (var systemHeader in systemHeadersDict.ToViewModel())
            {
                systemHeader.IsSystemHeader = true;
                allHeaders.Add(new()
                {
                    Id = systemHeader.Id,
                    IsSystemHeader = systemHeader.IsSystemHeader,
                    Key = systemHeader.Key,
                    Value = systemHeader.Value,
                    Enabled = true,
                });
            }
        }
    }

    private void AddRequestHeader(string key, string value)
    {
        requestHeaders.Add(new() { Key = key, Value = value });
        SyncToNetworkRequest();
        UpdateAllHeaders();
        StateHasChanged();
    }

    protected void NotifyCopied(string value)
    {
        Snackbar.Add($"Copied `{value}` to clipboard", Severity.Info);
    }

    protected Task<DataGridEditFormAction> UpdateHeader(HeaderModel m)
    {
        if (m.IsSystemHeader)
            return Task.FromResult(DataGridEditFormAction.Close);

        var header = requestHeaders.Find(x => x.Id.Equals(m.Id));
        if (header != null)
        {
            header.Key = m.Key;
            header.Value = m.Value;
            header.Enabled = m.Enabled;
            SyncToNetworkRequest();
            UpdateAllHeaders();
        }
        StateHasChanged();
        return Task.FromResult(DataGridEditFormAction.Close);
    }

    protected void ToggleHeaderEnabled(HeaderModel m, bool enabled)
    {
        if (m.IsSystemHeader)
            return;

        var header = requestHeaders.Find(x => x.Id.Equals(m.Id));
        if (header != null)
        {
            header.Enabled = enabled;
            SyncToNetworkRequest();
            UpdateAllHeaders();
        }
        StateHasChanged();
    }

    protected void DeleteHeader(HeaderModel m)
    {
        if (m.IsSystemHeader)
            return;

        requestHeaders.Remove(m);
        SyncToNetworkRequest();
        UpdateAllHeaders();
        StateHasChanged();
    }

    private void SetKey(HeaderModel row, string? key)
    {
        if (row.IsSystemHeader)
            return;

        row.Key = key;
        CommitRows();
    }

    private void SetValue(HeaderModel row, string? value)
    {
        if (row.IsSystemHeader)
            return;

        row.Value = value;
        CommitRows();
    }

    // A row and the tab change in the same handler, so no render sees them disagree
    private void CommitRows()
    {
        SyncToNetworkRequest();
        UpdateAllHeaders();
    }

    private IEnumerable<KeyValuePair<string, string>> SentHeaders() => requestHeaders
        .Where(x => !string.IsNullOrWhiteSpace(x.Key) && x.Enabled)
        .Select(x => new KeyValuePair<string, string>(x.Key!, x.Value ?? ""));

    private void SyncToNetworkRequest() => Tabs.SetHeaders(NetworkRequest.Id, SentHeaders());

}

